{
  "manifest_version": 3,
  "name": "QueryBot Audio Converter",
  "version": "1.6.3",
  "key": "",
  "description": "Send the current YouTube video to the QueryBot Windows native host and convert it to FLAC locally.",
  "permissions": [
    "activeTab",
    "tabs",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*",
    "https://youtu.be/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "QueryBot Audio Converter",
    "default_popup": "popup.html"
  }
}
